{
    "name": "cleaniquecoders/laravel-config-webhook",
    "description": "Define, sign, dispatch and log outgoing webhooks in Laravel with retries, HMAC signatures, and an optional Livewire + Flux admin UI.",
    "keywords": [
        "Cleanique Coders",
        "laravel",
        "laravel-config-webhook"
    ],
    "homepage": "https://github.com/cleaniquecoders/laravel-config-webhook",
    "license": "MIT",
    "authors": [
        {
            "name": "Nasrul Hazim Bin Mohamad",
            "email": "nasrulhazim.m@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "livewire/livewire": "^3.0||^4.0",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0.0||^11.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "suggest": {
        "livewire/livewire": "Required for the optional admin UI component (^3.0||^4.0)",
        "livewire/flux": "Required to render the bundled Flux admin UI"
    },
    "autoload": {
        "psr-4": {
            "CleaniqueCoders\\ConfigWebhook\\": "src/",
            "CleaniqueCoders\\ConfigWebhook\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleaniqueCoders\\ConfigWebhook\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CleaniqueCoders\\ConfigWebhook\\ConfigWebhookServiceProvider"
            ],
            "aliases": {
                "ConfigWebhook": "CleaniqueCoders\\ConfigWebhook\\Facades\\ConfigWebhook"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
